# Supabase 대시보드 → Project Settings → API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=https://여기에-프로젝트-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=여기에-anon-public-키
SUPABASE_SERVICE_ROLE_KEY=여기에-service-role-키

# (선택) donations 테이블 자동 생성: Project Settings → Database → Connection string URI
# node scripts/apply-donations-table.mjs 실행 시 필요
# DATABASE_URL=postgresql://postgres.[ref]:[PASSWORD]@...

# 토스페이먼츠 (설정 시 실제 결제 후 기부 반영) — docs/TOSS_PAYMENTS_SETUP.md 참고
# NEXT_PUBLIC_TOSS_CLIENT_KEY=test_gck_...
# TOSS_SECRET_KEY=test_gsk_...
# NEXT_PUBLIC_USD_KRW_RATE=1400
# USD_KRW_RATE=1400
# ALLOW_MOCK_DONATIONS=true
